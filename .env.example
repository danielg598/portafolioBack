# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.

MAIL_USERNAME=tu-cuenta@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail

# A quién le llegan los mensajes del formulario de contacto
CONTACT_RECIPIENT=tu-cuenta@gmail.com

# Datos públicos que el frontend consume via /api/config
CONTACT_WHATSAPP=57XXXXXXXXXX
CONTACT_EMAIL_DISPLAY=tu-cuenta@gmail.com

# Orígenes permitidos para CORS (en producción cambia por tu dominio)
CORS_ALLOWED_ORIGINS=http://localhost:4200
