# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.

# Envío de correo vía API HTTPS de Brevo (no SMTP: Render bloquea los
# puertos SMTP 25/465/587 en el plan free). Crea una cuenta gratis en
# https://www.brevo.com, genera una API key (SMTP & API > API Keys) y
# verifica un remitente (Senders, Domains & Dedicated IPs > Senders).
BREVO_API_KEY=tu-api-key-de-brevo
BREVO_SENDER_EMAIL=remitente-verificado-en-brevo@tudominio.com

# A quién le llegan los mensajes del formulario de contacto
CONTACT_RECIPIENT=tu-cuenta@gmail.com

# Datos públicos que el frontend consume via /api/config
CONTACT_WHATSAPP=57XXXXXXXXXX
CONTACT_EMAIL_DISPLAY=tu-cuenta@gmail.com

# Orígenes permitidos para CORS (en producción cambia por tu dominio)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Secreto para el endpoint de keep-alive GET /api/health/ping
# (header requerido: X-Health-Token). Genera uno random, no uses este texto.
HEALTH_CHECK_TOKEN=cambia-esto-por-un-valor-secreto-random
